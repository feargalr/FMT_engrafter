/*
 * Nextflow config for nf-core/mag on Pawsey Setonix.
 *
 *   nextflow run nf-core/mag -r 5.4.2 -profile singularity -c nextflow.config ...
 *
 * Replace pawseyXXXX and youruser throughout.
 */

process {
    executor       = 'slurm'
    queue          = 'work'
    clusterOptions = '--account=pawseyXXXX'

    /*
     * Nextflow is launched from a login node where Singularity is available,
     * but each SLURM job starts with its own environment. Load Singularity
     * explicitly inside every compute job.
     */
    beforeScript = '''
        module load singularity/4.1.0-slurm
    '''

    // 'lenient' caching compares size and timestamp rather than checksums.
    // Required on Lustre, otherwise -resume re-runs everything.
    cache       = 'lenient'
    // Symlink rather than copy inputs - avoids duplicating large FASTQ files
    // across thousands of task directories.
    stageInMode = 'symlink'
}

/*
 * Keep Nextflow work files on scratch - they are enormous and will exhaust
 * a $HOME quota immediately. Note scratch is purged after 21 days.
 */
workDir = '/scratch/pawseyXXXX/youruser/nxf_work'

/*
 * Container images are cached in project software space so they are not
 * downloaded again for every run.
 */
singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = '/software/projects/pawseyXXXX/youruser/.nextflow_singularity'
}
